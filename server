app.get('/payment-success', async (req, res) => {
    try {
        const { studentId } = req.query;
        const student = await Student.findById(studentId);

        if (student) {
            student.isCleared = true;
            await student.save();

            let studentTx = await Transaction.findOne({ studentId: student.studentId });

            if (studentTx) {
                studentTx.status = 'Paid';
                studentTx.referenceNo = 'PAY-' + Math.floor(100000 + Math.random() * 900000);
                studentTx.date = getCurrentFormattedDate();
                await studentTx.save();
            } else {
                await Transaction.create({
                    studentId: student.studentId,
                    description: 'Graduation Fee Payment',
                    referenceNo: 'PAY-' + Math.floor(100000 + Math.random() * 900000),
                    amount: 1500,
                    status: 'Paid',
                    date: getCurrentFormattedDate()
                });
            }
        }
        res.redirect('/dashboard');
    } catch (error) {
        res.status(500).send("Payment processing error");
    }
});

