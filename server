app.delete('/api/admin/student/:id', requireAdminLogin, async (req, res) => {
    try {
        const studentId = req.params.id;
        const student = await Student.findByIdAndDelete(studentId);

        if (student) {
            await Transaction.deleteMany({ studentId: student.studentId });
            return res.json({ success: true, message: "Student account erased." });
        }

        res.status(404).json({ success: false, message: "Student record not found." });
    } catch (error) {
        res.status(500).json({ success: false, error: error.message });
    }
});


// STUDENT ROUTES & AUTHENTICATION

app.post('/api/signup', async (req, res) => {
    try {
        const { firstName, lastName, studentId, course, email, password } = req.body;
        const existingStudent = await Student.findOne({ email });

        if (existingStudent) {
            return res.send('<h3>Email already registered! <a href="/login.html">Login here</a></h3>');
        }

        const fullName = `${firstName}${lastName}`.trim();

        const newStudent = await Student.create({
            fullName,
            studentId,
            course,
            email,
            password,
            isCleared: false
        });

        await Transaction.create({
            studentId: newStudent.studentId,
            description: 'Graduation Fee Assessment',
            referenceNo: 'REF-PENDING',
            amount: 1500,
            status: 'Unpaid',
            date: getCurrentFormattedDate()
        });

        req.session.user = { id: newStudent._id.toString(), email: newStudent.email };
        res.redirect('/dashboard');
    } catch (error) {
        res.status(500).send(`Error creating account: ${error.message}`);
    }
});

