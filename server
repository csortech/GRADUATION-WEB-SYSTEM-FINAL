// DITO PARA MA CHECK YUNG MGA STUDENT DATA FROM MONGODB
app.get('/api/staff/students', requireStaffLogin, async (req, res) => {
    try {
        const students = await Student.find();
        const formattedStudents = await Promise.all(students.map(async (s) => {
            const tx = await Transaction.findOne({ studentId: s.studentId });
            return {
                id: s._id.toString(),
                fullName: s.fullName,
                studentId: s.studentId,
                course: s.course,
                email: s.email,
                isCleared: s.isCleared,
                hasEntered: s.hasEntered || false,
                entryTime: s.entryTime || null,
                paymentStatus: tx ? tx.status : 'Unpaid',
                referenceNo: tx ? tx.referenceNo : 'N/A'
            };
        }));
        res.json(formattedStudents);
    } catch (error) {
        res.status(500).json({ error: "Failed to fetch student data for staff dashboard" });
    }
});

// STAFF API CLEARANCE CHECK
app.post('/api/staff/set-clearance', requireStaffLogin, async (req, res) => {
    try {
        const { id, isCleared } = req.body;
        const student = await Student.findById(id);

        if (!student) {
            return res.status(404).json({ success: false, message: "Student not found" });
        }

        student.isCleared = isCleared;
        await student.save();

        let studentTx = await Transaction.findOne({ studentId: student.studentId });

        if (studentTx) {
            studentTx.status = isCleared ? 'Paid' : 'Unpaid';
            if (isCleared && studentTx.referenceNo.includes('PENDING')) {
                studentTx.referenceNo = 'TXN-' + Math.floor(100000 + Math.random() * 900000);
            }
            studentTx.date = getCurrentFormattedDate();
            await studentTx.save();
        } else {
            await Transaction.create({
                studentId: student.studentId,
                description: 'Graduation Fee Payment',
                referenceNo: isCleared ? ('TXN-' + Math.floor(100000 + Math.random() * 900000)) : 'REF-PENDING',
                amount: 1500,
                status: isCleared ? 'Paid' : 'Unpaid',
                date: getCurrentFormattedDate()
            });
        }

        return res.json({ success: true, isCleared: student.isCleared });
    } catch (error) {
        res.status(500).json({ success: false, error: error.message });
    }
});

// STAFF API TO CONFIRM ENTRY
app.post('/api/staff/check-in', requireStaffLogin, async (req, res) => {
    try {
        const { id } = req.body;
        const student = await Student.findById(id);

        if (!student) {
            return res.status(404).json({ success: false, message: "Student record not found." });
        }

        student.hasEntered = true;
        student.entryTime = `${getCurrentFormattedDate()} at${getCurrentFormattedTime()}`;
        await student.save();

        return res.json({
            success: true,
            message: `Successfully marked ${student.fullName} as Entered!`,
            entryTime: student.entryTime
        });
    } catch (error) {
        res.status(500).json({ success: false, error: error.message });
    }
});

// STAFF API FOR VERIFICATION
app.get('/api/staff/verify', requireStaffLogin, async (req, res) => {
    try {
        const { query } = req.query;
        if (!query) {
            return res.status(400).json({ error: "Search query is required" });
        }

        const student = await Student.findOne({
            $or: [
                { studentId: new RegExp(`^${query}$`, 'i') },
                { fullName: new RegExp(query, 'i') }
            ]
        });

        if (!student) {
            return res.json({ found: false, message: "No record found for this Student ID or Name." });
        }

        const tx = await Transaction.findOne({ studentId: student.studentId });

        return res.json({
            found: true,
            student: {
                id: student._id.toString(),
                studentId: student.studentId,
                fullName: student.fullName,
                course: student.course,
                isCleared: student.isCleared,
                paymentStatus: tx ? tx.status : 'Unpaid',
                hasEntered: student.hasEntered || false,
                entryTime: student.entryTime || null,
                canEnter: student.isCleared && (tx && tx.status === 'Paid')
            }
        });
    } catch (error) {
        res.status(500).json({ error: "Venue verification server error" });
    }
});


